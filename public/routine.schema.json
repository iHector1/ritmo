{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ritmo routine",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "name",
        "target",
        "sets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "notes": {
          "type": "string"
        },
        "catalogId": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string",
          "pattern": "^https://(www\\.)?(youtube\\.com/watch\\?v=|youtu\\.be/)[\\w-]{11}$"
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "name",
        "exercises"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "notes": {
          "type": "string"
        },
        "timerSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7200
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "required": [
        "id",
        "label",
        "weekday",
        "focus",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "weekday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  }
}
